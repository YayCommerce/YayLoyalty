{
  "name": "yaycommerce/yayloyalty",
  "type": "wordpress-plugin",
  "require": {
    "php": "^7.4 || ^8.0",
    "yaycommerce/admin-shell": "^2.10"
  },
  "repositories": {
    "admin-shell": {
      "type": "vcs",
      "url": "https://github.com/YayCommerce/yaycommerce-plugin-admin-shell.git"
    }
  },
  "require-dev": {
    "humbug/php-scoper": "^0.18.20",
    "thecodingmachine/safe": "^3.4",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "brain/monkey": "^2.6"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "classmap": [
      "vendor-prefixed/src",
      "YayLoyaltyPluginAdapter.php"
    ]
  },
  "scripts": {
    "shell-update": "yaycommerce-update",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit-integration.xml.dist"
  }
}
