{
  "core": "https://wordpress.org/wordpress-7.1.3.zip",
  "phpVersion": "8.2",
  "plugins": [
    "https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip"
  ],
  "mappings": {
    "wp-content/plugins/yayloyalty": "../.."
  },
  "port": 9190,
  "testsEnvironment": true,
  "config": {
    "YAYLOYALTY_IS_DEVELOPMENT": false,
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true
  },
  "lifecycleScripts": {
    "afterStart": "bash ./bin/setup-env.sh",
    "afterClean": "bash ./bin/setup-env.sh"
  }
}
